+// Negative binomial with mean `mean` and variance mean+phi*mean^2 (Champion v2 receptions). CDF by the exact pmf recurrence.
+function negativeBinomialCDF(k, mean, phi){
+  if(!finiteNumber(mean) || mean<0 || !finiteNumber(phi) || phi<1e-6 || !finiteNumber(k)) return null;
+  if(k<0) return 0;
+  k=Math.floor(k);
+  if(mean===0) return 1;
+  if(mean>1000 || k>10000) return null;
+  const size=1/phi, success=size/(size+mean), failure=1-success;
+  let term=Math.exp(size*Math.log(success)), sum=term;
+  for(let i=0;i<k;i++){
+    term*=(i+size)/(i+1)*failure;
+    sum+=term;
+    if(term<1e-18 && i>mean+10) break;
+  }
+  return Math.min(1,Math.max(0,sum));
+}
+function countCDF(k, model){
+  return model.dispersion_phi>0 ? negativeBinomialCDF(k, model.lambda, model.dispersion_phi) : poissonCDF(k, model.lambda);
+}
