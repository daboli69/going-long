+body[data-going-workspace=home] .home-next{border-top:1px solid #264756;margin:0 3px 16px;padding-top:11px;display:flex;align-items:center;gap:12px}body[data-going-workspace=home] .home-next svg{flex:none;width:32px;height:32px;fill:none;stroke:#416279;stroke-width:2}body[data-going-workspace=home] .home-next strong,body[data-going-workspace=home] .home-next span{display:block}body[data-going-workspace=home] .home-next strong{font-size:10px;font-weight:600;line-height:1.5}body[data-going-workspace=home] .home-next span{font-size:9.5px;line-height:1.5;color:var(--g-muted,#b6ccdc)}
