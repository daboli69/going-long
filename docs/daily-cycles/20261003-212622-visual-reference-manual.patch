diff --git a/shared/visual-pages.css b/shared/visual-pages.css
new file mode 100644
index 0000000000000000000000000000000000000000..fb8733d6cf4df2f8b8f6edecda06e76aa6a5d04e
--- /dev/null
+++ b/shared/visual-pages.css
@@ -0,0 +1,42 @@
+/* Approved Home geometry, 852px reference at 426 CSS px; actual routes stay live. */
+body[data-going-workspace=home] .visual-home{max-width:1180px;margin:auto;padding:0 11px 24px;color:var(--g-text,#f2f7fa)}
+body[data-going-workspace=home] .home-hero{position:relative;isolation:isolate;margin:0 -11px;padding:58px 20px 18px;min-height:286px;background:linear-gradient(90deg,#00111acc 0%,#00111a45 63%,transparent),url('/shared/visual-assets/football-hero.webp') center right/cover no-repeat}
+body[data-going-workspace=home] .home-wordmark{display:block;width:max-content;font-family:var(--v-display,"GOING Display",Impact,sans-serif);font-size:83px;font-style:italic;font-weight:950;line-height:.91;letter-spacing:-4px;display:inline-block}
+body[data-going-workspace=home] .home-wordmark:after{content:'';display:block;width:75px;height:10px;transform:skewX(-10deg);background:var(--g-accent,#3bedcf);margin:10px 0 13px}
+body[data-going-workspace=home] .home-hero h1{font-size:27px;font-weight:850;font-style:italic;line-height:1.07;letter-spacing:-.7px;margin:0 0 10px}body[data-going-workspace=home] .home-hero h1 span{color:var(--g-accent,#3bedcf)}
+body[data-going-workspace=home] .home-hero p{max-width:238px;margin:0;color:var(--g-muted,#b6ccdc);font-size:12.5px;line-height:1.35}
+body[data-going-workspace=home] .home-sports{display:grid;gap:9px;position:relative;margin:0 0 15px}
+body[data-going-workspace=home] .home-sport{position:relative;overflow:hidden;isolation:isolate;min-height:149px;border:1px solid var(--sport-accent);border-radius:11px;padding:13px 13px 11px;background:linear-gradient(90deg,#03141bed 0%,#06121da8 55%,#03101935),var(--sport-image) right center/cover no-repeat;box-shadow:0 0 12px var(--sport-glow)}
+.home-football{--sport-accent:#32ead4;--sport-glow:#26dac017;--sport-image:url('/shared/visual-assets/football-hero.webp')}.home-baseball{--sport-accent:#ff873d;--sport-glow:#ff873d12;--sport-image:url('/shared/visual-assets/baseball-card.webp')}
+body[data-going-workspace=home] .sport-number{font-size:9px;letter-spacing:1.5px;color:var(--g-muted,#b6ccdc)}body[data-going-workspace=home] .home-sport h2{font-size:30px;line-height:1.05;letter-spacing:-1px;font-weight:850;margin:8px 0}body[data-going-workspace=home] .home-sport h2 span{color:var(--sport-accent)}body[data-going-workspace=home] .home-sport p{color:var(--g-muted,#b6ccdc);font-size:10.5px;line-height:1.4;max-width:267px;margin:0 0 10px}
