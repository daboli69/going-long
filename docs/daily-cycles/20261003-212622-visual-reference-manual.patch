+/* Approved 04/05 references: 852 × 1846 raster, measured at 426 CSS px.
+ * Score: ~405 px-wide card, 22 px rank strip, 49 px ring, four fact tiles.
+ * Roles: ~397 px-wide card, three metrics, 5 px bars, separate 8 px card gaps.
+ * Sampled body-card modes: Cheatsheets #0b1924; Score #071620/#0e1f2d.
+ * Real explanation/risk/actions remain accessible; their content can exceed the
+ * illustrative reference's density. No score, quote or evidence is synthesized.
+ */
+#btScorePanel, .football-cheatsheets {
+  --research-ink: #f1f7fa;
+  --research-muted: #abc2d1;
+  --research-line: #294b5e;
+  --research-teal: #49e3c3;
+  --research-coral: #ff858a;
+  --research-surface: #0b1924;
+}
+
+#btScorePanel .score-hero {
+  position: relative;
+  overflow: hidden;
+  border: 0;
+  border-radius: 0;
+  padding: 18px 10px 16px;
+  background: linear-gradient(90deg,#021019 0%,#021019d9 55%,#02101922),url('/shared/visual-assets/football-hero.webp') right center / cover;
+}
+#btScorePanel .score-hero h2 {
+  font-family: var(--v-display, 'GOING Wide Display', Archivo, sans-serif);
+  font-style: italic;
+  font-weight: 900;
+  font-size: clamp(30px,7.8vw,48px);
+  line-height: 1;
+  letter-spacing: -.035em;
+  margin: 0 0 10px;
+  color: var(--research-ink);
+}
+#btScorePanel .score-hero h2 span { color: var(--research-coral); }
+#btScorePanel .score-hero>div { display: flex; flex-direction: column; }
+#btScorePanel .score-hero h2 { order: -1; }
+#btScorePanel .score-hero small { font-size: 10px; letter-spacing: .17em; color: #c7dce7; }
+#btScorePanel .score-hero p { margin: 10px 0 0; font-size: 12px; line-height: 1.5; max-width: 37ch; color: #c2d3df; }
+#btScorePanel .score-hero aside { background: #04121bd9; border-color: var(--research-line); color: var(--research-muted); }
+
+#btScorePanel .score-market-row {
+  display: grid;
+  grid-template-columns: repeat(4,minmax(0,1fr));
+  gap: 5px;
+  overflow: visible;
+  padding: 0;
+  margin: 0 0 11px;
+}
+#btScorePanel .score-market-row button {
+  min-width: 0;
+  min-height: 44px;
+  padding: 7px 5px;
+  border-radius: 9px;
+  border: 1px solid var(--research-line);
+  background: linear-gradient(120deg,#142b3b,#0a1b26);
+  color: var(--research-ink);
+  font: 500 11px/1.25 Inter,system-ui,sans-serif;
+  text-transform: none;
+  white-space: normal;
+}
+#btScorePanel .score-market-row button[aria-pressed=true] {
+  color: var(--research-teal);
+  border-color: #21e4c1;
+  background: linear-gradient(110deg,#004237,#09282d);
+  box-shadow: inset 0 0 12px #09c7a319,0 0 8px #09c7a316;
+}
+#btScorePanel .score-toolbar { gap: 8px; }
+#btScorePanel .score-toolbar .field {
+  min-width: 0;
+  min-height: 44px;
+  border-radius: 9px;
+  border: 1px solid #41677a;
+  background: linear-gradient(110deg,#102634,#0b1c27);
+  color: var(--research-ink);
+  font-size: 12px;
+}
+#btScorePanel .score-view-row { gap: 5px; padding-bottom: 0; margin: 0; }
+#btScorePanel .score-view-row button { font: 500 11px/1.3 Inter,system-ui,sans-serif; min-height: 44px; border-radius: 8px; text-transform: none; }
+#btScorePanel .score-summary { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 5px; margin: 10px 0 12px; }
+#btScorePanel .score-summary>div {
+  min-width: 0;
+  min-height: 51px;
+  padding: 8px 9px;
+  border-radius: 8px;
+  border: 1px solid #22c5ac;
+  background: linear-gradient(125deg,#063329,#061823);
+}
