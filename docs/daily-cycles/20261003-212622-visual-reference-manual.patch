+#btScorePanel .score-summary span { font-size: 9px; line-height: 1.35; letter-spacing: 0; text-transform: none; color: #bfd7db; }
+#btScorePanel .score-summary>div:nth-child(2) { border-color: #05b9e7; background: linear-gradient(125deg,#032c40,#061823); }
