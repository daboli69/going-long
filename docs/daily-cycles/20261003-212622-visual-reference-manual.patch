+#btScorePanel #scoreStatus { color: var(--research-muted); font-size: 10px; line-height: 1.45; }
+#btScorePanel .score-list { gap: 7px; }
+#btScorePanel .score-card {
+  position: relative;
+  display: grid;
+  grid-template-columns: 24px minmax(0,1fr) 110px;
+  gap: 7px 9px;
+  min-width: 0;
+  padding: 7px 8px 8px 5px;
+  border: 1px solid var(--research-line);
+  border-radius: 10px;
+  background: linear-gradient(115deg,#0e1f2d,#071620 55%,#0b1b27);
+  box-shadow: inset 3px 0 #286371;
+}
+#btScorePanel .score-card:first-child { border-color: #00dfbb; box-shadow: inset 3px 0 #00bc9b,0 0 10px #00d9b012; }
+#btScorePanel .score-rank {
+  grid-column: 1;
+  grid-row: 1 / span 2;
+  width: 24px;
+  height: 100%;
+  min-height: 64px;
+  place-items: start center;
+  padding-top: 12px;
+  border: 1px solid #193c4c;
+  border-radius: 6px;
+  background: linear-gradient(#173747,#061b25);
+  color: var(--research-ink);
+  font: 750 12px/1.2 Inter,system-ui,sans-serif;
+}
+#btScorePanel .score-player { min-width: 0; }
+#btScorePanel .score-player h3 { font: 750 14px/1.2 Inter,system-ui,sans-serif; color: var(--research-ink); overflow-wrap: anywhere; }
+#btScorePanel .score-player>small { display: block; font-size: 9px; line-height: 1.4; color: #bdd5df; }
+#btScorePanel .score-player .score-tags { margin: 5px 0 0; gap: 3px; }
+#btScorePanel .score-tag { font: 500 8px/1.35 Inter,system-ui,sans-serif; padding: 2px 4px; color: #bed2dd; border-color: #26495b; letter-spacing: 0; text-transform: none; }
+#btScorePanel .score-card>.score-player+div { display: flex; align-items: center; gap: 6px; min-width: 0; }
+#btScorePanel .score-gauge { flex: 0 0 49px; width: 49px; height: 49px; margin: 0; background: conic-gradient(from -18deg,var(--research-coral) calc(var(--score)*1%),#183340 0); }
+#btScorePanel .score-gauge:before { inset: 5px; background: #0b1d27; }
+#btScorePanel .score-gauge b { font: 750 15px/1.1 Inter,system-ui,sans-serif; }
+#btScorePanel .score-gauge span { font-size: 5px; letter-spacing: 0; margin-top: 2px; }
+#btScorePanel .score-tier { min-width: 0; margin: 0; text-align: left; font: 650 7px/1.5 'IBM Plex Mono',monospace; color: var(--research-coral); overflow-wrap: anywhere; }
+#btScorePanel .score-facts { grid-column: 2 / 4; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 5px; }
+#btScorePanel .score-fact { border: 1px solid #203e50; border-radius: 5px; padding: 6px; background: linear-gradient(120deg,#142b3a,#0b1e2b); }
+#btScorePanel .score-fact span { font: 400 8px/1.35 Inter,system-ui,sans-serif; color: #afc8d7; text-transform: none; letter-spacing: 0; margin-bottom: 3px; }
+#btScorePanel .score-fact b { font: 700 11px/1.3 Inter,system-ui,sans-serif; color: var(--research-ink); }
+#btScorePanel :is(.score-driver-summary,.score-risk,.score-card>details,.score-card>.best-actions,.score-card>.injury-badge) { grid-column: 2 / 4; min-width: 0; }
+#btScorePanel .score-driver-summary { color: var(--research-muted); font-size: 10px; line-height: 1.5; }
+#btScorePanel .score-driver-summary ul { margin: 5px 0; padding-left: 15px; }
+#btScorePanel .score-risk { background: #081923; border-color: var(--research-coral); padding: 6px 8px; font-size: 10px; line-height: 1.5; color: var(--research-muted)!important; }
+#btScorePanel .score-card>details { border-top-color: #284554; padding-top: 3px; font-size: 11px; color: var(--research-muted); }
+#btScorePanel .score-card summary { min-height: 44px; align-content: center; font-size: 11px; color: var(--research-ink); }
+#btScorePanel .score-card .best-actions { margin: 0; gap: 5px; }
+#btScorePanel .score-card .best-actions button { min-height: 44px; padding: 6px 9px; font-size: 10px; border-radius: 6px; text-transform: none; }
+#btScorePanel .score-method { border: 1px solid #294959; background: #071922; border-radius: 8px; margin: 8px 0; padding: 5px 9px; font-size: 11px; }
+#btScorePanel .score-method summary { min-height: 44px; align-content: center; font-size: 11px; }
+#btScorePanel :is(button,input,select,summary):focus-visible { outline: 2px solid var(--research-teal); outline-offset: 3px; }
