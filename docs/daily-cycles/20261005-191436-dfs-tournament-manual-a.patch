+const {test}=require('node:test'),assert=require('node:assert/strict');
+const U=require('../shared/dfs-upside.js'),D=require('../shared/football-dfs.js');
+const now=Date.parse('2026-10-05T22:00:00Z');
+function sample(){return {games:Array.from({length:10},(_,i)=>({season:i<6?2025:2026,date:i<6?`2025-11-${10+i}`:`2026-09-${10+i}`,pass_yds:0,pass_tds:0,rush_yds:i*20,rush_tds:0,rec_yds:0,rec_tds:0,receptions:0}))};}
+test('upside uses observed joint partial scoring including actual bonuses; separates forecast mean from spread',()=>{const u=U.observed(sample(),12,{now,points:D.projectedPoints});assert.equal(u.source,U.SOURCE);assert.equal(u.n,10);assert.equal(u.currentGames,4);assert.equal(u.historicalQ90,19);assert.equal(u.historicalMean,10.5);assert.equal(u.value,20.5);assert.equal(u.spread,8.5);});
+test('small samples, missing fields, future and current-day rows never create artificial ceilings',()=>{const p=sample();assert.equal(U.observed({games:p.games.slice(0,7)},12,{now,points:D.projectedPoints}),null);p.games.push({...p.games[0],date:'2026-10-05',rush_yds:900},{...p.games[0],date:'2026-10-06',rush_yds:999});const u=U.observed(p,12,{now,points:D.projectedPoints});assert.equal(u.n,10);delete p.games[0].rec_tds;assert.equal(U.observed(p,12,{now,points:D.projectedPoints}).n,9);});
+test('receptions follow platform scoring without independent component simulation',()=>{const p=sample();p.games.forEach(g=>g.receptions=4);const dk=U.observed(p,12,{now,points:D.projectedPoints}),fd=U.observed(p,12,{site:'fanduel',now,points:D.projectedPoints});assert.equal(dk.historicalMean-fd.historicalMean,2);assert.equal(dk.spread,fd.spread);});
