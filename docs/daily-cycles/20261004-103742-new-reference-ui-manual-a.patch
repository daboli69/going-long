+.r-surface h3 small{float:right;color:var(--r-muted);font:500 10px/1.5 Inter}
+.r-surface p,.r-game-evidence p,.r-plays-sidebar p{font-size:12px;color:#bbd5e3;margin:9px 0}
+.r-surface a,.r-inline-links a,.r-plays-sidebar a{color:var(--r-teal);font-size:12px;text-decoration:none}
+.r-table-scroll{overflow:auto}
+.r-table-scroll table{width:100%;border-collapse:collapse;font-size:12px}
+.r-table-scroll th,.r-table-scroll td{border-bottom:1px solid #153040;padding:10px;text-align:left}
+.r-table-scroll th{font-weight:550}.r-table-scroll th small{display:block;color:var(--r-muted);font-size:10px;margin-top:3px}
+.r-table-scroll thead{color:var(--r-muted);font-size:10px;text-transform:uppercase;letter-spacing:.5px}
+.r-stamp{font-size:11px;color:var(--r-muted)}
+.r-game-rows{display:grid}
+.r-game-rows button{background:transparent!important;border:0!important;border-bottom:1px solid #173646!important;border-radius:0!important;text-align:left;display:grid;gap:4px;width:100%;padding:13px 9px!important;color:#eaf5fc!important;box-shadow:none!important;min-width:0}
