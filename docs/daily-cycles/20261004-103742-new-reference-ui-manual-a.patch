+++ b/shared/reference-workspace.css
@@ -0,0 +1,300 @@
+/* New approved Oct 4 references: 1536x1024 desktop, 1024x1536 tall tablet.
+   Scope keeps the earlier Home, Cheatsheets, Score and Evidence references intact. */
+body[data-reference-active=true]{--r-bg:#010d14;--r-surface:#01121c;--r-border:#194458;--r-muted:#9abccb;--r-teal:#00e4d0;--g-bg:var(--r-bg);--g-surface:var(--r-surface);--g-border:var(--r-border);--g-muted:var(--r-muted);--g-accent:var(--r-teal);--g-control:#011b27;--g-control-hover:#073a48;--g-control-ink:#e6f4fd;--g-text-sm:12px;--g-space-3:8px;--g-space-4:12px;background:radial-gradient(ellipse at 55% 35%,#03233355,transparent 75%),var(--r-bg)}
+html:has(body[data-reference-active=true]){scrollbar-width:none}
