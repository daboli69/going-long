+body[data-reference-active=true] #btBestPanel>h2{font:italic 850 27px/1.1 var(--v-display);margin:0 0 7px}
+body[data-reference-active=true] #btBestPanel>.slate-orientation{font-size:12px;margin:0 0 12px}
