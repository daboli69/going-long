+body[data-reference-active=true] #bestTodaySummary>*{min-height:70px;padding:12px!important;border:1px solid var(--r-border)!important;border-radius:8px!important;position:relative;background:#011722!important;box-shadow:none!important;display:grid;grid-template-columns:35px 1fr;align-items:center;gap:0 8px;text-align:left}
