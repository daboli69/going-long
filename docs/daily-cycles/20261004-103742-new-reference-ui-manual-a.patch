+body[data-reference-active=true] #btSportGroup button{min-height:34px;font-size:13px;padding:6px 15px!important}
+body[data-reference-active=true]:not([data-visual-tool=today]) #btSportGroup{position:absolute;right:42px;top:14px;z-index:2;width:180px;background:#01141deb;border-radius:8px}
+body[data-reference-active=true] .bt-head{position:relative}
+body[data-reference-active=true] #btToolGroup{margin:0 0 12px}
+body[data-reference-active=true] .g-source-status{font-size:11px;min-height:26px;margin:0 0 10px;border-color:var(--r-border)}
+body[data-reference-active=true] .g-source-status summary{min-height:26px;padding:5px 10px}
+body[data-reference-active=true] h2,body[data-reference-active=true] h3{color:#eef6fc}
+body[data-reference-active=true] h3{font:650 15px/1.35 Inter,system-ui;margin:0 0 12px}
+body[data-reference-active=true] p{line-height:1.5}
+body[data-reference-active=true] button,body[data-reference-active=true] select,body[data-reference-active=true] input{border-radius:6px}
