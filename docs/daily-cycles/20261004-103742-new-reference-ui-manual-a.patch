+body[data-reference-active=true] #view-betting #bestTodaySummary>*{height:70px;min-height:70px;border-color:var(--r-border)!important;background:#011620!important}
+body[data-reference-active=true] #view-betting #bestTodaySummary .v-summary-icon{width:28px;height:28px}.r-today-advanced{margin:15px 0}.r-today-advanced>details{font-size:12px;margin:10px 0}.r-today-advanced>.slate-primary{display:flex;align-items:center;gap:12px;margin:12px 0}
+body[data-reference-view=plays] #view-betting #btBestPanel>h2,body[data-reference-view=plays] #view-betting #btBestPanel>.slate-orientation,body[data-reference-view=plays] #bestTodaySummary,body[data-reference-view=plays] .r-view-tabs{display:none}
