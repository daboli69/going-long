+body[data-reference-active=true] #view-betting{max-width:none!important;width:100%;margin:0;padding:0 0 65px!important;background:transparent}
+body[data-reference-active=true] #view-betting .bt-head{top:auto!important;gap:0}
+body[data-reference-active=true] #view-betting .v-football-hero{padding:24px!important}
+body[data-reference-active=true] #view-betting #btDfsPanel,body[data-reference-active=true] #view-betting #btPromoPanel,body[data-reference-active=true] #view-betting #btParlaysPanel{max-width:none;width:100%;margin:0;padding:0}
+body[data-reference-active=true] #view-betting .g-source-status{padding:0;min-height:26px}
+body[data-reference-active=true] #view-betting .g-source-status>summary{min-height:26px;padding:5px 10px}
+body[data-reference-active=true] #view-betting button[aria-pressed=true]{color:#eaf8fc!important}
+body[data-reference-active=true] #view-betting #btSportGroup button[aria-pressed=true],body[data-reference-active=true] #view-betting #btPeriodGroup button[aria-pressed=true]{background:linear-gradient(130deg,#16f0d7,#00cbbf)!important;color:#00232a!important;border-color:#00dac9!important}
+body[data-reference-active=true] #view-betting .r-game-rows button{background:transparent!important;border:0!important;border-bottom:1px solid #173646!important;border-radius:0!important;font-weight:500!important;box-shadow:none!important}
+body[data-reference-active=true] #view-betting .r-game-rows button[aria-pressed=true]{background:linear-gradient(100deg,#00423966,#012735)!important;border:1px solid var(--r-teal)!important;border-radius:6px!important;box-shadow:inset 0 0 12px #00dfc71a!important}
+body[data-reference-active=true] #view-betting .r-game-rows button b{font-weight:550}
+body[data-reference-active=true] #view-betting .r-games-list .r-game-row{padding:8px!important;height:53px;min-height:53px}
+body[data-reference-active=true] #view-betting .r-row-teams .g-team-mark,body[data-reference-active=true] #view-betting .r-match-teams .g-team-mark{font-size:0;padding:0;border:0;background:none;min-width:0;min-height:0;gap:0;width:auto}
+body[data-reference-active=true] #view-betting .r-row-teams .g-team-mark img{width:29px;height:29px}
+body[data-reference-active=true] #view-betting .r-match-teams .g-team-mark img{width:70px;height:70px}
+body[data-reference-active=true] #view-betting .bt-wrap{max-width:1500px;margin:0 auto;padding:8px 20px 65px}
+body[data-reference-active=true] .v-football-hero{height:146px;min-height:146px;padding:24px;border:1px solid var(--r-border);border-radius:9px;background:linear-gradient(90deg,#01111bef 30%,#00141d88 55%,transparent 75%),url('./reference-helmet.webp') right center/auto 100% no-repeat,#00121c;overflow:hidden;margin:0 0 8px}
+body[data-reference-active=true] .v-hero-kicker{font-size:12px;letter-spacing:.3px;margin:0 0 10px;display:block;color:#acd1e0}
+body[data-reference-active=true] .v-football-hero h1{font:italic 900 50px/1 var(--v-display);letter-spacing:-1px;margin:0 0 9px}
+body[data-reference-active=true] .v-football-hero p{font-size:14px;line-height:1.4;max-width:65%;margin:0;color:#c7deeb}
+body[data-reference-active=true] .v-hero-features{display:none}
+body[data-reference-active=true] #btTabGroup{gap:8px;margin:0 0 12px;grid-template-columns:repeat(9,minmax(0,1fr))}
+body[data-reference-active=true] #btTabGroup>button,body[data-reference-active=true] #btTabGroup>.bt-more-tools>summary{min-height:52px;height:52px;border:1px solid var(--r-border)!important;border-radius:7px!important;padding:8px 10px!important;gap:9px;background:linear-gradient(120deg,#011622,#01101a)!important;box-shadow:none!important}
+body[data-reference-active=true] #btTabGroup>button[aria-pressed=true]{border-color:var(--r-teal)!important;background:linear-gradient(120deg,#004239,#012329)!important;box-shadow:inset 0 0 15px #00dfc714!important}
+body[data-reference-active=true] #btTabGroup .v-icon{width:24px;height:24px;stroke:var(--r-teal)}
+body[data-reference-active=true] #btTabGroup [data-section=cheatsheets] .v-icon{stroke:#ff5374}body[data-reference-active=true] #btTabGroup [data-section=parlay] .v-icon,body[data-reference-active=true] #btTabGroup [data-section=jackpot] .v-icon{stroke:#ffc22b}body[data-reference-active=true] #btTabGroup [data-section=score] .v-icon{stroke:#ff785b}
+body[data-reference-active=true] .v-tool-label{font-size:11px;font-weight:600;line-height:1.2;text-align:left}
+body[data-reference-active=true] .v-tool-label small{font-size:9px;line-height:1.2;margin-top:3px;display:block;color:#afc9d7}
+body[data-reference-active=true] .v-tool-chevron{display:none}
