+ function coverageName(v){
+  const raw=String(v||'').trim();
+  if(/^2[ _-]MAN$/i.test(raw))return 'Cover 2 Man';
+  const cover=raw.match(/^COVER[ _-]?(\d)$/i);
+  return cover?`Cover ${cover[1]}`:raw?cap(raw.toLowerCase()):'Coverage unavailable';
+ }
+ function coverageState(v){
+  return {leading_1_7:'leading by 1–7 points',leading_8_plus:'leading by 8+ points',trailing_1_7:'trailing by 1–7 points',trailing_8_plus:'trailing by 8+ points',tied:'tied'}[v]||'score state unavailable';
+ }
+ function coverageCopy(v){
+  return String(v||'No published explanation.').replace(/\bCOVER[ _-]?(\d)\b/gi,(_,n)=>`Cover ${n}`).replace(/\b2[ _-]MAN\b/gi,'Cover 2 Man').replace(/\b(leading|trailing)[ _]1[ _]7\b/g,(_,direction)=>`${direction} by 1–7 points`).replace(/\b(leading|trailing)[ _]8[ _](?:plus|\+)\b/g,(_,direction)=>`${direction} by 8+ points`);
+ }
