+function release(repo,runId){const current=owner(repo);if(!current||current.runId!==runId)throw Error('Only the recorded cycle owner can release the lock');const dir=location(repo);fs.unlinkSync(path.join(dir,'owner.json'));fs.rmdirSync(dir);return {released:runId};}
+module.exports={acquire,release,owner,location};if(require.main===module){const[action,repo,runId]=process.argv.slice(2);try{if(!repo||!['acquire','release','status'].includes(action))throw Error('Usage: session.cjs acquire|release|status REVIEW_CHECKOUT [UNIQUE_CYCLE_ID]');console.log(JSON.stringify(action==='status'?owner(repo):action==='acquire'?acquire(repo,runId):release(repo,runId)));}catch(e){console.error(e.message);process.exitCode=1;}}
