+let incumbent=[];
+function effectiveLocks(){const locks={...S.locks},rows=S.lineup.length?S.lineup:incumbent;rows.forEach((p,i)=>{if(Date.parse(p.kickoff)<=Date.now())locks[i]=p.id;});return locks;}
+const slots=['QB','RB','RB','WR','WR','WR','TE','FLEX','DST'];
+function options(){return {mode:S.mode,lockedSlots:S.locks,excludedIds:[...S.excluded],now:new Date().toISOString(),incumbentLineup:S.lineup.length?S.lineup:incumbent};}
+function eligible(p,slot){return p.position===slot||(slot==='FLEX'&&['RB','WR','TE'].includes(p.position));}
+function retainFocus(fn){const y=window.scrollY,id=document.activeElement?.id;fn();if(id)document.getElementById(id)?.focus({preventScroll:true});window.scrollTo({top:y,behavior:'instant'});}
+function summary(){const salary=S.lineup.reduce((a,p)=>a+p.salary,0),points=S.lineup.reduce((a,p)=>a+p.projection,0),td=S.lineup.reduce((a,p)=>a+(p.position==='DST'?0:p.tdMean),0);return {salary,points,td};}
