+const S={parsed:null,pool:[],lineup:[],locks:{},excluded:new Set(),mode:'throne',builtMode:null,confirmed:false,status:'Import the official salary file from your selected DraftKings contest.',swap:null,hash:'',importedAt:'',query:'',filter:'ALL',busy:false};
