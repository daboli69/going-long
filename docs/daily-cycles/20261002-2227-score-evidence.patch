+(function(root){
+'use strict';
+// Prospective, user-selected observations. These counts are not a model backtest.
+const CAPACITY=10000, MARKETS=['atd','pass_yds','pass_tds','rush_yds','receptions'];
+const finite=x=>typeof x==='number'&&Number.isFinite(x);
